{
  "name": "@ysgao/ontograph-cli-standalone",
  "version": "0.2.2",
  "description": "Standalone CLI for OntoGraph OWL ontology reasoning — bundles a Java runtime, zero external dependencies (no VS Code, no system Java)",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18"
  },
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64"
  ],
  "main": "dist/main.js",
  "bin": {
    "ontograph": "dist/main.js"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "fetch-runtime": "node scripts/fetch-runtime.mjs",
    "build": "node esbuild.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit": "npm audit --omit=dev"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
